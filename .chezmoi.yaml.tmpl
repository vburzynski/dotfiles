{{- $name := "" -}}
{{- if hasKey . "name" -}}
{{-   $name = .name -}}
{{- else -}}
{{-   $name = promptString "FullName" -}}
{{- end -}}

{{- $email := "" -}}
{{- if hasKey . "email" -}}
{{-   $email = .email -}}
{{- else -}}
{{-   $email = promptString "Email Address" -}}
{{- end -}}

{{- $signingkey := "" -}}
{{- if hasKey . "signingkey" -}}
{{-   $signingkey = .signingkey -}}
{{- else -}}
{{-   $signingkey = promptString "Signing Key Location" -}}
{{- end -}}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}
  signingkey: {{ $signingkey | quote }}
